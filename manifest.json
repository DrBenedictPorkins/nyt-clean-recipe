{
  "manifest_version": 3,
  "name": "NYT Clean Recipe",
  "version": "0.1.0",
  "description": "Open NYT Cooking recipes in a clean, ad-free reading tab.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["https://cooking.nytimes.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cooking.nytimes.com/*"],
      "js": ["src/extract.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cooking.nytimes.com/*"],
      "js": ["src/extract.js", "src/content-links.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open clean recipe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
